# Copy to .env and fill in values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL (used by Docker Compose to create the database)
# ---------------------------------------------------------------------------
POSTGRES_USER=payops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payops
POSTGRES_PORT=5432

# SQLAlchemy URL used by the app. Host is "localhost" when the API runs on your
# machine, and "db" (the Compose service name) when the API runs in Compose.
DATABASE_URL=postgresql+psycopg://payops:change-me@localhost:5432/payops

# Separate database for integration tests (created by the test fixtures).
TEST_DATABASE_URL=postgresql+psycopg://payops:change-me@localhost:5432/payops_test

# ---------------------------------------------------------------------------
# LLM provider (routed through LiteLLM)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq                # groq | gemini | ollama
LLM_MODEL=llama-3.3-70b-versatile  # model name for the chosen provider

# Only the key for the provider you use is required.
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama runs locally; no key needed. Use http://host.docker.internal:11434
# when the API runs inside Docker and Ollama runs on the Mac host.
OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# LLM reliability: timeouts, retries, free-tier throttling
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=1.0     # exponential backoff: base * 2^attempt + jitter
LLM_BACKOFF_MAX_SECONDS=60
LLM_REQUESTS_PER_MINUTE=25       # client-side throttle; keep under provider limit
LLM_TOKENS_PER_MINUTE=5000       # client-side token budget; 0 disables

# ---------------------------------------------------------------------------
# Policy / guardrails
# ---------------------------------------------------------------------------
APPROVAL_THRESHOLD_AMOUNT=10000  # balances above this need human approval
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Seed data and evaluation
# ---------------------------------------------------------------------------
SEED_RANDOM_SEED=42              # makes Faker output reproducible
SEED_NUM_CUSTOMERS=60
EVAL_DATASET_VERSION=v1          # which evals/datasets/<version> to run
EVAL_REPORTS_DIR=evals/reports
