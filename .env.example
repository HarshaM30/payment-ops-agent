# Copy to .env and fill in values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# Clients send this in the X-API-Key header. Every endpoint except /health
# requires it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# Signs the session cookie and CSRF tokens for the HTML approvals page.
# Generate the same way as API_KEY, but use a different value.
SESSION_SECRET=replace-with-a-different-long-random-string

# ---------------------------------------------------------------------------
# PostgreSQL (used by Docker Compose to create the database)
# ---------------------------------------------------------------------------
POSTGRES_USER=payops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payops
POSTGRES_PORT=5432

# SQLAlchemy URL used by the app. Host is "localhost" when the API runs on your
# machine, and "db" (the Compose service name) when the API runs in Compose.
DATABASE_URL=postgresql+psycopg://payops:change-me@localhost:5432/payops

# Separate database for integration tests (created by the test fixtures).
TEST_DATABASE_URL=postgresql+psycopg://payops:change-me@localhost:5432/payops_test

# ---------------------------------------------------------------------------
# LLM provider (routed through LiteLLM)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq                # groq | gemini | ollama | fake (no key, for tests/CI/load tests)
# Leave empty for the provider default (checked 2026-11-15, see src/payops/llm/models.py):
#   groq   -> openai/gpt-oss-120b   (free plan; Llama models need an Enterprise plan)
#   gemini -> gemini-3.5-flash-lite (free tier)
#   ollama -> llama3.2              (local, `ollama pull llama3.2`)
#   fake   -> fake-v1
LLM_MODEL=

# Only the key for the provider you use is required.
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama runs locally; no key needed. Use http://host.docker.internal:11434
# when the API runs inside Docker and Ollama runs on the Mac host.
OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# LLM reliability: timeouts, retries, free-tier throttling
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=1.0     # exponential backoff: base * 2^attempt + jitter
LLM_BACKOFF_MAX_SECONDS=60
LLM_REQUESTS_PER_MINUTE=25       # client-side throttle; keep under provider limit
LLM_TOKENS_PER_MINUTE=5000       # client-side token budget; 0 disables

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
PROMPT_VERSION=v1                # loads agents/prompts/<node>_<version>.md; stored on each run
RESEARCH_MAX_STEPS=5             # cap on LLM tool-calling rounds per invoice in research

# ---------------------------------------------------------------------------
# Policy / guardrails
# ---------------------------------------------------------------------------
APPROVAL_THRESHOLD_AMOUNT=10000  # balances above this need human approval
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Seed data and evaluation
# ---------------------------------------------------------------------------
SEED_RANDOM_SEED=42              # makes Faker output reproducible
SEED_NUM_CUSTOMERS=60
# Database the eval runner wipes and refills for every scenario. Empty means
# DATABASE_URL's database name plus "_eval" (e.g. payops_eval). Never point it at DATABASE_URL.
EVAL_DATABASE_URL=
EVAL_DATASET_VERSION=v1          # which evals/datasets/<version> to run
EVAL_REPEATS=1                   # times to run each scenario; >1 reports mean ± std
EVAL_REPORTS_DIR=evals/reports
